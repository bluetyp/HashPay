{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hashpay",
  "account_id": "78488d7eaec03f4bbde972c395ba559d",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hashpay",
      "database_id": "5ec67776-25d1-4878-9345-c205d8154579",
      "migrations_dir": "src/server/db/d1/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE_NOTIFY",
        "queue": "hashpay-notify"
      }
    ],
    "consumers": [
      {
        "queue": "hashpay-notify",
        "max_batch_size": 10
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "pay.zheqitech.com",
      "custom_domain": true
    }
  ]
}
